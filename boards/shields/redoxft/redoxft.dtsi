/*
 * Redox FT — wspólna definicja matrycy 5×14 (col2row)
 * Kolumny dodawane osobno w redoxft_left.overlay / redoxft_right.overlay
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include "redoxft-layouts.dtsi"
/*
 * Rozszerzenie węzła: dodaj transform i kscan do fizycznego layoutu.
 * Musi być POZA blokiem / {} — to jest referencja do etykiety.
 */
&redoxft_physical_layout {
    transform = <&default_transform>;
    kscan = <&kscan0>;
};
/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &redoxft_physical_layout;
    };
    /*
     * Mapowanie matrycy: 70 klawiszy
     * Kolumny 0-6  = lewa połówka
     * Kolumny 7-13 = prawa połówka (col-offset = <7> w right.overlay)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                   RC(0,8) RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(0,6)               RC(0,7) RC(1,8) RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(1,6)               RC(1,7) RC(2,8) RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(2,6) RC(3,6)   RC(3,7) RC(2,7) RC(3,8) RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13)
RC(4,0) RC(4,1) RC(4,2) RC(4,3)      RC(4,4)    RC(4,5) RC(4,6)   RC(4,7) RC(4,8)     RC(4,9)    RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};
